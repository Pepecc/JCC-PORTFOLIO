---
import Layout from '../layouts/Layout.astro';

const jobs = [
  {
    company: 'Viewnext',
    positions: [
      {
        role: 'Coordinador técnico · Desarrollador SAP BTP (Node.js / CAP)',
        period: 'Septiembre 2025 - actualidad',
        summary:
          'Proyectos para grandes empresas sobre <code>SAP BTP Cloud Foundry</code>, con <code>Node.js</code>, <code>TypeScript</code>, <code>SAP CAP/CDS</code>, <code>HANA Cloud</code> y <code>XSUAA</code>.',
        projects: [
          {
            name: 'Middleware Node.js/NestJS',
            period: 'sept 2025 - actualidad',
            role: 'Coordinador técnico',
            highlights: [
              'Coordinación técnica del equipo e interlocución diaria con el cliente para el seguimiento de incidencias y temas críticos.',
              'Resolución de incidencias en producción y diagnóstico de incidencias multicapa (frontend, <code>Node.js</code>, SAP), guiando al equipo en su análisis.',
              'Análisis de rendimiento y pruebas de carga del servicio, e implantación del <code>Autoscaler</code> de SAP BTP para eliminar las caídas ante picos de carga.',
            ],
          },
          {
            name: 'Aplicación de servicios CAP',
            period: 'dic 2025 - actualidad',
            role: 'Referente técnico CAP',
            highlights: [
              'Resolución de incidencias en producción y desarrollo de evolutivos sobre una aplicación con un amplio catálogo de servicios <code>SAP CAP</code>, con análisis de datos en <code>HANA Cloud</code> (SQL).',
              'Gestión de los despliegues a producción de la aplicación y sus servicios asociados.',
              'Upgrade y refactorización de dependencias obsoletas para mantener la plataforma actualizada.',
            ],
          },
          {
            name: 'Integraciones y servicios CAP',
            period: 'oct 2026 - actualidad',
            role: 'Coordinador técnico',
            highlights: ['Coordinación técnica del proyecto desde su fase inicial.'],
          },
        ],
      },
      {
        role: 'Desarrollador Full Stack (Node.js / React / Vue.js)',
        period: 'Octubre 2021 - Marzo 2026',
        highlights: [
          'Desarrollo full stack de aplicaciones empresariales con <code>React</code> en frontend y <code>Node.js</code>, <code>Express</code> y <code>TypeScript</code> en backend, entre ellas una aplicación para registrar, categorizar y consultar el conocimiento derivado de proyectos.',
          'Desarrollo frontend y backend de un asistente virtual corporativo con <code>Azure OpenAI</code>, desplegado en <code>Azure Kubernetes Service</code> e integrado con <code>Microsoft Foundry</code> (2023 - 2026).',
          'Desarrollo de un chatbot empresarial con <code>IBM Watson Assistant</code> (2021 - 2023).',
          'Trabajo con servicios <code>Azure</code> (AKS, Azure DevOps, API Management, Application Gateway, Blob Storage, Entra ID) y <code>AWS</code> (ECR, EKS, S3), con CI/CD basado en <code>Docker</code> y <code>Kubernetes</code>.',
          'Bases de datos relacionales (<code>PostgreSQL</code>) y NoSQL (<code>Azure Cosmos DB</code>, <code>Firebase</code>).',
        ],
      },
    ],
  },
];
---

<Layout
  title="Mi trabajo"
  description="Explora la experiencia laboral de Josep Company Cuesta"
  image="/og-image.jpg"
>
  <section>
    <div class="main-container">
      <p class="route">~/mi-trabajo</p>
      <h1>Mi trabajo</h1>
      <br />
      {
        jobs.map((job) => (
          <article>
            <h2>
              {job.company}
              <span style="color: var(--color-primary)">()</span>
            </h2>
            {job.positions.map((position) => (
              <div class="position">
                <h3 class="role">{position.role}</h3>
                <h3>{position.period}</h3>
                {position.summary && <p set:html={position.summary} />}
                {position.highlights && (
                  <ul>
                    {position.highlights.map((highlight) => (
                      <li set:html={highlight} />
                    ))}
                  </ul>
                )}
                {position.projects?.map((project) => (
                  <div class="project">
                    <h4>
                      {project.name} · {project.period} ·{' '}
                      <span class="role">{project.role}</span>
                    </h4>
                    <ul>
                      {project.highlights.map((highlight) => (
                        <li set:html={highlight} />
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            ))}
          </article>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .main-container {
    margin-left: auto;
    margin-right: auto;
    max-width: 750px;
    min-height: 100vh;
    box-sizing: border-box;
    background-color: var(--color-surface);
    transition:
      background-color 0.3s,
      border-color 0.3s;
    color: var(--color-text);
  }

  .route {
    font-size: 0.75rem;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .position {
    margin-bottom: 4rem;
  }

  .role {
    color: var(--color-primary);
  }

  .project {
    margin-top: 2rem;
  }

  li {
    margin-bottom: 1rem;
  }
</style>
