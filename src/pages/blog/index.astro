---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
  title="Blog"
  description="Artículos y notas de Josep Company Cuesta sobre desarrollo web y tecnología."
  image="/og-image.jpg"
>
  <section>
    <div class="main-container">
      <p class="route">~/blog</p>
      <h1>Blog</h1>
      <br />
      {
        posts.length === 0 ? (
          <p>Todavía no hay entradas publicadas.</p>
        ) : (
          <ul class="posts-list">
            {posts.map((post) => (
              <li class="post-item">
                <article>
                  <h2>
                    <a href={`/blog/${post.id}/`}>[{post.data.title}]</a>
                  </h2>
                  <h3>{formatDate(post.data.pubDate)}</h3>
                  <p>{post.data.description}</p>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .main-container {
    margin-left: auto;
    margin-right: auto;
    max-width: 750px;
    min-height: 100vh;
    box-sizing: border-box;
    background-color: var(--color-surface);
    transition:
      background-color 0.3s,
      border-color 0.3s;
    color: var(--color-text);
  }

  .route {
    font-size: 0.75rem;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .posts-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-item {
    margin-bottom: 3rem;
  }
</style>
